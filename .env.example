# Runtime
NODE_ENV=production
PORT=5177
DATA_DIR=/app/data
SESSION_COOKIE_SECURE=true

# Replace with your real domain after DNS is ready.
APP_DOMAIN=course.example.com

# Full Excel backup and Baidu Netdisk integration (values are intentionally blank).
BAIDU_APP_KEY=
BAIDU_APP_SECRET=
BAIDU_REDIRECT_URI=
BACKUP_ENCRYPTION_KEY=
