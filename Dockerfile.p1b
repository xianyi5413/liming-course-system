FROM --platform=linux/amd64 node:24.18.0-alpine3.24@sha256:4ba75f835bb8802193e4c114572113d4b26f95f6f094f4b5229d2a77773e0afc

WORKDIR /workspace

COPY scripts/p1a ./scripts/p1a
COPY scripts/p1b ./scripts/p1b
COPY tests/p1b ./tests/p1b

RUN mkdir -p /p1b-readonly \
  && chmod 0555 /p1b-readonly \
  && chown -R node:node /workspace

USER node

CMD ["node", "scripts/p1b/run_locked_tests.js"]
