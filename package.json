{
  "name": "liming-course-system",
  "version": "0.1.0",
  "private": true,
  "description": "黎明教育课程管理系统本地 MVP",
  "scripts": {
    "start": "node src/server.js",
    "init": "node src/server.js --init-db",
    "db:backup": "node scripts/backup_sqlite.js",
    "db:export-json": "node scripts/export_sqlite_json.js",
    "db:export-postgres": "node scripts/sqlite_to_postgres_sql.js",
    "db:restore": "node scripts/restore_sqlite_backup.js",
    "excel:full:export": "node scripts/excel_backup/export_full_excel.js",
    "excel:full:verify": "node scripts/excel_backup/verify_full_excel.js",
    "excel:full:restore": "node scripts/excel_backup/restore_full_excel.js",
    "excel:template": "node scripts/excel_backup/create_template.js",
    "excel:import": "node scripts/excel_backup/import_full_excel.js",
    "excel:acceptance-fixture": "node scripts/excel_backup/create_acceptance_fixture.js",
    "test:full-excel": "node --test --test-concurrency=1 tests/full_excel_restore.test.js",
    "test:excel-import": "node --test --test-concurrency=1 tests/excel_import_template.test.js",
    "test:data-center": "node --test --test-concurrency=1 tests/backup_service.test.js",
    "test:data-preflight": "node --test --test-concurrency=1 tests/data_preflight.test.js",
    "test:student-stage-conflicts": "node --test --test-concurrency=1 tests/student_grade_stage_conflicts.test.js",
    "test:teacher-detail": "node --test --test-concurrency=1 tests/teacher_detail.test.js",
    "test:backup-scheduler": "node --test --test-concurrency=1 tests/backup_scheduler.test.js",
    "test:baidu-backup": "node --test --test-concurrency=1 tests/baidu_backup.test.js",
    "test:data-center-contract": "node --test --test-concurrency=1 tests/data_center_contract.test.js",
    "test:data-center-api": "node --test --test-concurrency=1 tests/data_center_api.test.js",
    "test:data-center-page": "node --test --test-concurrency=1 tests/data_center_page.test.js",
    "test:page-first-load": "node --test --test-concurrency=1 tests/page_first_load.test.js",
    "test:opening-balances": "node --test --test-concurrency=1 tests/opening_balance_global.test.js",
    "test:unified-filters": "node --test --test-concurrency=1 tests/unified_filters.test.js",
    "test:dashboard-card": "node --test --test-concurrency=1 tests/dashboard_card.test.js",
    "test:multi-page-regressions": "node --test --test-concurrency=1 tests/multi_page_regressions.test.js",
    "test:backup-async": "node --test --test-concurrency=1 tests/backup_async.test.js",
    "test:excel-size-analysis": "node --test --test-concurrency=1 tests/excel_size_analysis.test.js",
    "test:batch-pricing-rules": "node --test --test-concurrency=1 tests/batch_pricing_rules.test.js",
    "test:backup-record-list": "node --test --test-concurrency=1 tests/backup_service.test.js tests/data_center_api.test.js tests/data_center_page.test.js",
    "test:layout-regressions": "node --test --test-concurrency=1 tests/dashboard_card.test.js tests/unified_filters.test.js tests/multi_page_regressions.test.js",
    "test:table-cell-layouts": "node --test --test-concurrency=1 tests/table_cell_layouts.test.js",
    "test:adaptive-table-columns": "node --test --test-concurrency=1 tests/adaptive_table_columns.test.js",
    "test:recharge-channel-inline": "node --test --test-concurrency=1 tests/recharge_channel_inline.test.js",
    "test:student-balances": "node src/server.js --verify-student-balances",
    "audit:student-balances": "node src/server.js --audit-student-balances",
    "trace:student-balance": "node src/server.js --trace-student-balance=秦小沫",
    "import:excel": "node -e \"console.log('Usage: python scripts/import_workbook.py <xlsx-path> [--month YYYY-MM-01] [--append] [--skip-teacher-adjustments] [--teacher-order 老师1,老师2]')\""
  },
  "engines": {
    "node": ">=24"
  }
}
